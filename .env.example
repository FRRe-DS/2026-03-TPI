#nombres de db, usuarios, cache, host, y puertos
DB_USER
DB_PASS
DB_NAME
#si es true significa que el framework se intenta conectar desde fuera del contenedor
#si el framework de testing es externo al contenedor, debe hacer consultas al localhost y puerto del os
#contrario el framework "vive" en el contenedor y necesita la misma referencia interna
#valores "FALSE"/"TRUE"
FRAMEWORK_TESTING_EXTERNO
#este nombre host debe ser igual al del contenedor que hace referencia
REDIS_HOST
#default 6379
REDIS_PORT
#host externo si estuviera en otro servidor fisico, localhost default
REDIS_EXTERNAL_HOST
#valores de acceso de keycloak
DB_KEYCLOAK
DB_KEYCLOAKUSER
DB_KEYCLOAKPASSWORD
KEYCLOAK_ADMIN
#url del dominio donde se obtiene claves publicas, por defecto keycloak url
KEYCLOAK_JWKS_URL
#dominio url donde se obtienen los tokens de autenticaciones valios para mandarlos al header y consumir endpoints externos al modulo
KEYCLOAK_TOKEN_URL
DATABASE_URL=postgresql://userm4:m4123@localhost:5432/m4db
LOG_LEVEL=# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL, un valor solo lee/despliega alertas de su nivel o superior (ese orden)
#valores maximos de solicitudes, son enteros
RL_UBICACION_MAX
RL_ESTADO_MAX
RL_CERCANOS_MAX
RL_RESERVA_MAX
RL_ESTIMACION_MAX
RL_GEOCODIF_MAX
#cantidad de tiempo por la cual es aceptable los valores maximos (valor/tiempo), son enteros y reprecentan segundos
RL_UBICACION_VENTANA
RL_ESTADO_VENTANA
RL_CERCANOS_VENTANA
RL_RESERVA_VENTANA
RL_ESTIMACION_VENTANA
RL_GEOCODIF_VENTANA
#url base para consumir endpoints de M3, basicamente sus prefijos definidos
M3_BASE_URL
#token de autenticacion para M3, uno gral, inexpirable para pruebas
M3_SERVICE_TOKEN
#tiempo de espera hasta abortar consumo, son segundos
M3_TIMEOUT_SECONDS
# el client id definido por keycloak, M3 son grupo-2 y grupo-15
M3_CLIENT_ID_ACTUAL
#grupo-2
M3_CLIENT_ID2
#grupo-15
M3_CLIENT_ID15
#client secret de keycloak
M3_CLIENT_SECRET_ACTUAL
G2_CLIENT_SECRET
G15_CLIENT_SECRET
#token M3 estatico para pruebas
M3_SERVICE_TOKEN

