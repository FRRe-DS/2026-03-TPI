#nombres de db, usuarios, cache, host, y puertos
DB_USER
DB_PASS
DB_NAME
#si es true significa que el framework se intenta conectar desde fuera del contenedor
#si el framework de testing es externo al contenedor, debe hacer consultas al localhost y puerto del os
#contrario el framework "vive" en el contenedor y necesita la misma referencia interna
#valores "FALSE"/"TRUE"
FRAMEWORK_TESTING_EXTERNO
#este nombre host debe ser igual al del contenedor que hace referencia
REDIS_HOST
#default 6379
REDIS_PORT
#host externo si estuviera en otro servidor fisico, localhost default
REDIS_EXTERNAL_HOST
#valores de acceso de keycloak
DB_KEYCLOAK
DB_KEYCLOAKUSER
DB_KEYCLOAKPASSWORD
KEYCLOAK_ADMIN
KEYCLOAK_ADMIN_PASSWORD
DATABASE_URL=postgresql://userm4:m4123@localhost:5432/m4db
LOG_LEVEL=# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL, un valor solo lee/despliega alertas de su nivel o superior (ese orden)
KEYCLOAK_JWKS_URL=#url del dominio donde se obtiene claves publicas, por defecto keycloak url
#valores maximos de solicitudes, son enteros
RL_UBICACION_MAX
RL_ESTADO_MAX
RL_CERCANOS_MAX
RL_RESERVA_MAX
RL_ESTIMACION_MAX
RL_GEOCODIF_MAX
#cantidad de tiempo por la cual es aceptable los valores maximos (valor/tiempo), son enteros y reprecentan segundos
RL_UBICACION_VENTANA
RL_ESTADO_VENTANA
RL_CERCANOS_VENTANA
RL_RESERVA_VENTANA
RL_ESTIMACION_VENTANA
RL_GEOCODIF_VENTANA
